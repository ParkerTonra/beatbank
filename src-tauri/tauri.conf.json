{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "beatbank",
    "version": "0.9.1"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "path": {
        "all": true
      },
      "dialog": {
        "all": true
      },
      "fs": {
        "readDir": true,
        "copyFile": true,
        "createDir": true,
        "exists": true
      },
      "protocol": {
        "asset": true,
        "assetScope": ["**", "**/*"]
      },
      "shell": {
        "all": false,
        "open": "true"
      }
    },
    "windows": [
      {
        "title": "beatbank",
        "width": 1440,
        "height": 800
      }
    ],
    
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.beatbank.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [
        "../src/assets/*"
      ]
    }
  }
}
